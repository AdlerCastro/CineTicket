NODE_ENV=development
PORT=3333

# Postgres — em dev local aponta para o container do docker-compose (ver DevOps Agent)
DATABASE_URL="postgresql://cineticket:cineticket@localhost:5434/cineticket_dev"

# Secrets de JWT — nunca reaproveitar o mesmo valor entre eles (auth vs ingresso)
JWT_ACCESS_SECRET="troque-este-valor-em-dev-min-16-chars"
JWT_REFRESH_SECRET="troque-este-valor-em-dev-min-16-chars"
JWT_TICKET_SECRET="troque-este-valor-em-dev-min-16-chars"

# TMDb — https://www.themoviedb.org/settings/api
TMDB_API_KEY="troque-pela-sua-key-da-tmdb"

# Origens permitidas por CORS, separadas por vírgula
CORS_ORIGINS="http://localhost:3000"
