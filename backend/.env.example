# Postgres de dev (container docker-compose.yml na raiz do monorepo)
DATABASE_URL="postgresql://cineticket:cineticket@localhost:5434/cineticket_dev"

# Auth de usuário (access JWT)
JWT_ACCESS_SECRET=""

# Ingresso (JWT HS256 assinado com secret próprio — nunca o mesmo de auth)
JWT_TICKET_SECRET=""

# Integração TMDb (catálogo de filmes)
TMDB_API_KEY=""
